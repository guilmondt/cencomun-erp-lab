worker_processes 2;
pid @ROOT@/nginx/nginx.pid;
error_log @ROOT@/logs/nginx-error.log;
events { worker_connections 512; }
http {
  access_log @ROOT@/logs/nginx-access.log;
  client_body_temp_path @ROOT@/nginx/client_temp;
  fastcgi_temp_path @ROOT@/nginx/fastcgi_temp;
  uwsgi_temp_path @ROOT@/nginx/uwsgi_temp;
  scgi_temp_path @ROOT@/nginx/scgi_temp;
  proxy_temp_path @ROOT@/nginx/proxy_temp;
  types { text/css css; application/javascript js; text/html html; }
  server {
    listen 127.0.0.1:8080;
    server_name ccm-frappe.test;
    location /assets/ { alias @ROOT@/bench/sites/assets/; }
    location /socket.io {
      proxy_pass http://unix:@ROOT@/socketio.sock:;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
    location / {
      proxy_pass http://127.0.0.1:8000;
      proxy_set_header Host $host;
      proxy_set_header X-Frappe-Site-Name ccm-frappe.test;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 120s;
    }
  }
}
